{
  "name": "real-time-analytics",
  "version": "1.0.0",
  "description": "📊 High-performance real-time analytics platform with ClickHouse, WebSocket streaming, and ML-powered insights",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && next build",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:load": "k6 run tests/load/",
    "test:performance": "npm run test:load",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "analytics",
    "real-time",
    "clickhouse",
    "kafka",
    "websocket",
    "dashboard",
    "ml",
    "anomaly-detection",
    "data-visualization"
  ],
  "author": "Dawit Tegegnwork",
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^1.2.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/websocket": "^10.0.1",
    "bullmq": "^5.1.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "next": "^15.0.0",
    "pino": "^8.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "socket.io": "^4.6.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
